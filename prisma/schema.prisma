generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  ADJUSTMENT
  TRANSFER
  PURCHASE_RECEIPT
  SALES_ISSUE
}

enum MovementStatus {
  POSTED
  VOIDED
}

model Product {
  id                 Int              @id @default(autoincrement())
  sku                String           @unique
  name               String
  description        String?
  lowStockThreshold  Decimal?
  categoryId         Int?
  category           ProductCategory? @relation(fields: [categoryId], references: [id])
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  stockMovementLines StockMovementLine[]
  inventoryBalances   InventoryBalance[]

  @@index([name])
  @@index([categoryId])
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stockMovementLines StockMovementLine[]
  inventoryBalances   InventoryBalance[]

  @@index([name])
}

model StockMovement {
  id         Int            @id @default(autoincrement())
  type       MovementType
  status     MovementStatus @default(POSTED)
  reference  String?
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lines      StockMovementLine[]

  @@index([type])
  @@index([status])
  @@index([occurredAt])
}

model StockMovementLine {
  id            Int            @id @default(autoincrement())
  movementId    Int
  movement      StockMovement  @relation(fields: [movementId], references: [id])
  productId     Int
  product       Product        @relation(fields: [productId], references: [id])
  warehouseId   Int
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  quantityDelta Decimal
  createdAt     DateTime       @default(now())

  @@index([movementId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryBalance {
  id             Int      @id @default(autoincrement())
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  warehouseId    Int
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  quantityOnHand Decimal
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}
